<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0">
	<header>
		<product version="1.0" lang="en">Vensim</product>
		<vendor>Ventana Systems, Inc.</vendor>
		<created>
		</created>
		<modified>
		</modified>
		<name>
		</name>
		<caption>
		</caption>
	</header>
	<sim_specs method="RK4" time_units="Month">
		<start>0</start>
		<stop>100</stop>
		<dt>1</dt>
	</sim_specs>
	<model>
		<variables>
			<aux name="(Positive)_social_pressure">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Connections_among_residents)					</eqn>
			</aux>
			<aux name="Accessible_meeting_places">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Costs_of_activities,Feelings_of_trust_and_safety,Subsidies_from_local_and_national_governments,Volunteering)					</eqn>
			</aux>
			<aux name="Adjusting">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Admitting_to_feeling_lonely">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Social_stigma_of_loneliness)					</eqn>
			</aux>
			<aux name="Attractiveness_of_neighborhood_for_high_incomes">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Total_income_from_households)					</eqn>
			</aux>
			<aux name="Available_houses_are_to_small_and/or_too_expensive">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Housing_prices)					</eqn>
			</aux>
			<aux name="Bad_weather">
				<units></units>
				<doc></doc>
					<eqn>A FUNCTION OF(Bad_weather)					</eqn>
					<eqn>					</eqn>
			</aux>
			<aux name="Becoming_sick">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Getting_older)					</eqn>
			</aux>
			<aux name="Breaking_contact">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Becoming_sick,Moving)					</eqn>
			</aux>
			<aux name="Bureaucractic_barriers">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Speaking_Dutch)					</eqn>
			</aux>
			<aux name="Changing_of_physical_environment">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( More_newly_built_houses)					</eqn>
			</aux>
			<aux name="Connecting_with_similar_others">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Meeting_people)					</eqn>
			</aux>
			<aux name="Connection_in_the_neigborhood_across_social_groups">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Feeling_involved,Neighborhood_social_composition_changes,"Participating_in_neighborhood_activities_(in_Dutch)","Residential_self-segregation")					</eqn>
			</aux>
			<aux name="Connection_in_the_neighborhood">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Accessible_meeting_places)					</eqn>
			</aux>
			<aux name="Connections_among_residents">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Breaking_contact,Meeting_people)					</eqn>
			</aux>
			<aux name="Connections_from_a_trustworthy_\key_figure\">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Loneliness)					</eqn>
			</aux>
			<aux name="Costs_of_activities">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Housing_prices)					</eqn>
			</aux>
			<aux name="Demolition_of_housing">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Differing_social_norms_across_groups">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Neighborhood_becoming_more_diverse)					</eqn>
			</aux>
			<aux name="Difficulty_understanding_Dutch">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Discrimination">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( "Making_assumptions_or_judgements_of_other_social/cultural_norms")					</eqn>
			</aux>
			<aux name="Falling_into_a_routine">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Getting_older)					</eqn>
			</aux>
			<aux name="Feeling_involved">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Volunteering)					</eqn>
			</aux>
			<aux name="Feeling_safe_only_in_their_bubble">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Discrimination,Pursing_diverse_connections)					</eqn>
			</aux>
			<aux name="Feelings_of_trust_and_safety">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Connection_in_the_neigborhood_across_social_groups,Discrimination,Neighborhood_social_composition_changes)					</eqn>
			</aux>
			<aux name="Forming_deeper,_meaningful_realtionships">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Meeting_people)					</eqn>
			</aux>
			<aux name="Getting_advice_from_a_doctor,_specialist,_or_friend">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Admitting_to_feeling_lonely,Loneliness)					</eqn>
			</aux>
			<aux name="Getting_older">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Having_a_positive_experience">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( "Participating_in_neighborhood_activities_(in_Dutch)")					</eqn>
			</aux>
			<aux name="Having_family_close-by">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Having_time_and_energy">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Housing_prices">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Attractiveness_of_neighborhood_for_high_incomes)					</eqn>
			</aux>
			<aux name="Integration_into_Dutch_society">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Bureaucractic_barriers,"Participating_in_neighborhood_activities_(in_Dutch)")					</eqn>
			</aux>
			<aux name="Knowing_someone_who_is_participating_in_an_activity">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Social_isolation)					</eqn>
			</aux>
			<aux name="Living_alone">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Loneliness">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Breaking_contact,"Forming_deeper,_meaningful_realtionships",Social_isolation)					</eqn>
			</aux>
			<aux name="Lowering_the_threshold_for_participating">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Offering_cheap_food_and_drinks)					</eqn>
			</aux>
			<aux name="Making_assumptions_or_judgements_of_other_social/cultural_norms">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Understanding_of_other_social_norms_and_groups)					</eqn>
			</aux>
			<aux name="Meeting_people">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( "Connections_from_a_trustworthy_\"key_figure\"","Getting_advice_from_a_doctor,_specialist,_or_friend",Having_a_positive_experience,Knowing_someone_who_is_participating_in_an_activity,"Participating_in_neighborhood_activities_(in_Dutch)","Personality_/_openness_of_residents")					</eqn>
			</aux>
			<aux name="More_newly_built_houses">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Demolition_of_housing)					</eqn>
			</aux>
			<aux name="More_owner_occupied_homes">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( More_newly_built_houses,Neighborhood_social_composition_changes)					</eqn>
			</aux>
			<aux name="Moving">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Residents_displaced)					</eqn>
			</aux>
			<aux name="Neighborhood_becoming_more_diverse">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Neighborhood_social_composition_changes">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Housing_prices,Residents_displaced)					</eqn>
			</aux>
			<aux name="Offering_cheap_food_and_drinks">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Accessible_meeting_places)					</eqn>
			</aux>
			<aux name="Opportunies_for_practicing_Dutch">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Residents_only_socializing_in_groups_similar_to_themselves,Social_isolation)					</eqn>
			</aux>
			<aux name="Participating_in_neighborhood_activities_(in_Dutch)">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( "(Positive)_social_pressure",Bad_weather,Becoming_sick,"Connections_from_a_trustworthy_\"key_figure\"",Costs_of_activities,Feelings_of_trust_and_safety,"Getting_advice_from_a_doctor,_specialist,_or_friend",Knowing_someone_who_is_participating_in_an_activity,Living_alone,Lowering_the_threshold_for_participating,"Personality_/_openness_of_residents",Speaking_Dutch)					</eqn>
			</aux>
			<aux name="Personality_/_openness_of_residents">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Opportunies_for_practicing_Dutch)					</eqn>
			</aux>
			<aux name="Pursing_diverse_connections">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Feelings_of_trust_and_safety)					</eqn>
			</aux>
			<aux name="Residential_self-segregation">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Residents_only_socializing_in_groups_similar_to_themselves)					</eqn>
			</aux>
			<aux name="Residents_displaced">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( "Available_houses_are_to_small_and/or_too_expensive",Wide_price_gap_between_social_housing_and_private_sector)					</eqn>
			</aux>
			<aux name="Residents_only_socializing_in_groups_similar_to_themselves">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Connecting_with_similar_others,Falling_into_a_routine,Feeling_safe_only_in_their_bubble,"Participating_in_neighborhood_activities_(in_Dutch)")					</eqn>
			</aux>
			<aux name="Retiring">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Getting_older)					</eqn>
			</aux>
			<aux name="Sharing_or_spreading_information">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Speaking_Dutch,Volunteering)					</eqn>
			</aux>
			<aux name="Social_isolation">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Connections_among_residents,"Participating_in_neighborhood_activities_(in_Dutch)",Social_stigma_of_loneliness)					</eqn>
			</aux>
			<aux name="Social_norms_which_perhaps_contrast_one_another">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Differing_social_norms_across_groups)					</eqn>
			</aux>
			<aux name="Social_stigma_of_loneliness">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Loneliness)					</eqn>
			</aux>
			<aux name="Some_residents_no_longer_elligible_for_social_housing">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Demolition_of_housing)					</eqn>
			</aux>
			<aux name="Speaking_Dutch">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( "Personality_/_openness_of_residents")					</eqn>
			</aux>
			<aux name="Subsidies_from_local_and_national_governments">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( )					</eqn>
			</aux>
			<aux name="Total_income_from_households">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( More_owner_occupied_homes)					</eqn>
			</aux>
			<aux name="Understanding_of_other_social_norms_and_groups">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Pursing_diverse_connections,Social_norms_which_perhaps_contrast_one_another)					</eqn>
			</aux>
			<aux name="Volunteering">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Having_time_and_energy,Retiring,"Wanting_to_\"give_back\"_and_help_others")					</eqn>
			</aux>
			<aux name="Wanting_to_\give_back\_and_help_others">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Feelings_of_trust_and_safety)					</eqn>
			</aux>
			<aux name="Wide_price_gap_between_social_housing_and_private_sector">
				<units></units>
				<doc></doc>
					<eqn> A FUNCTION OF( Some_residents_no_longer_elligible_for_social_housing)					</eqn>
			</aux>
		</variables>
	</model>
</xmile>
